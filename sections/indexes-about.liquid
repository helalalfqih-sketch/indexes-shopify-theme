<section class="ix-page ix-about-page">
  <header class="ix-about-intro">
    <strong>indexes <span>Store</span></strong>
    <h1>من نحن / اتصل بنا</h1>
    <p>اندكس ستور متجر لمنتجات المنزل والسيارات والإلكترونيات والعناية الشخصية، مع إمكانية الطلب والتأكيد عبر واتساب.</p>
  </header>

  <div class="ix-about-benefits">
    <article>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7zM7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      <b>توصيل للمحافظات</b>
    </article>
    <article>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13v-2a8 8 0 0 1 16 0v2M5 13h3v6H5a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2ZM19 13h-3v6h3a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2Z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      <b>دعم عبر واتساب</b>
    </article>
    <article>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8M8 13h5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      <b>دفع عند الاستلام</b>
    </article>
    <article>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="4" width="6" height="6" rx="1" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="4" y="14" width="6" height="6" rx="1" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="14" width="6" height="6" rx="1" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      <b>تشكيلة متنوعة</b>
    </article>
  </div>

  <div class="ix-about-grid">
    <article class="ix-contact-card">
      <h2>معلومات التواصل</h2>
      <p>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h4l2 5-3 2c1 3 3 5 6 6l2-3 4 2v4c0 1-1 2-2 2C10 21 3 14 3 5c0-1 1-2 3-2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        <a dir="ltr" href="tel:+967771370740">+967 771 370 740</a>
      </p>
      <p>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6 7-12a7 7 0 1 0-14 0c0 6 7 12 7 12Z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="9" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        {{ settings.ix_contact_address | escape }}
      </p>
      <a class="ix-product-whatsapp" href="https://wa.me/967771370740" target="_blank" rel="noopener noreferrer">تواصل عبر واتساب</a>
    </article>

    <article class="ix-contact-form">
      <h2>أرسل رسالة</h2>
      {% form 'contact' %}
        {% if form.posted_successfully? %}<p class="ix-form-success">وصلت رسالتك بنجاح.</p>{% endif %}
        {{ form.errors | default_errors }}
        <label><span>الاسم</span><input type="text" name="contact[name]" autocomplete="name" required></label>
        <label><span>البريد الإلكتروني</span><input type="email" name="contact[email]" autocomplete="email" required></label>
        <label><span>الرسالة</span><textarea name="contact[body]" rows="4" required></textarea></label>
        <button class="ix-contact-submit" type="submit">إرسال</button>
      {% endform %}
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Indexes about contact",
  "settings": []
}
{% endschema %}
