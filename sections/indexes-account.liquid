<section class="ix-page ix-account-page">
  <div class="ix-page-title-row">
    <div>
      <h1 class="ix-page__title">حسابي</h1>
      <p class="ix-page-subtitle">الوصول إلى بيانات الحساب والطلبات المحفوظة في Shopify.</p>
    </div>
  </div>

  {% if customer %}
    <div class="ix-account-profile">
      <span class="ix-account-avatar">
        {{ customer.first_name | default: customer.email | slice: 0 | upcase }}
      </span>
      <div>
        <h2>{{ customer.name | default: customer.email }}</h2>
        <p>{{ customer.email }}</p>
      </div>
    </div>

    <nav class="ix-account-menu" aria-label="خيارات الحساب">
      <a href="{{ routes.account_url }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v14H5zM8 9h8M8 13h5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        <span>طلباتي</span><b>‹</b>
      </a>
      <a href="/pages/wishlist">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.3 4.7 13A5 5 0 0 1 12 6.2 5 5 0 0 1 19.3 13Z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        <span>المفضلة</span><b>‹</b>
      </a>
      <a href="{{ routes.account_url }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 21c.8-4.3 3.5-6.5 8-6.5s7.2 2.2 8 6.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        <span>إدارة الحساب</span><b>‹</b>
      </a>
      <a href="https://wa.me/967771370740" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13v-2a8 8 0 0 1 16 0v2M5 13h3v6H5a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2ZM19 13h-3v6h3a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2Z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        <span>المساعدة والدعم</span><b>‹</b>
      </a>
      <a class="ix-account-logout" href="{{ routes.account_logout_url }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H5v14h5M13 8l4 4-4 4M8 12h9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>تسجيل الخروج</span><b>‹</b>
      </a>
    </nav>
  {% else %}
    <div class="ix-account-guest">
      <span class="ix-account-avatar ix-account-avatar--guest">
        <img src="https://cdn.shopify.com/s/files/1/0664/0110/8053/files/ix-original-09-account-icon.png?v=1792358840&width=96" alt="" width="48" height="48">
      </span>
      <h2>أهلاً بك في حسابك</h2>
      <p>بعد تسجيل الدخول يمكنك الوصول إلى طلباتك وبيانات حسابك من Shopify.</p>
      <a class="ix-account-login" href="{{ routes.account_login_url }}">تسجيل الدخول</a>
      <a class="ix-account-support" href="https://wa.me/967771370740" target="_blank" rel="noopener noreferrer" aria-label="المساعدة عبر واتساب">{% render 'indexes-whatsapp-icon' %}<span>المساعدة عبر واتساب</span></a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Indexes account hub",
  "settings": []
}
{% endschema %}
